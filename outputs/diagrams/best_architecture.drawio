<mxCell id="wd_lstm1" value="Weight-Dropped LSTM layer 1&#10;DropConnect(p=0.5) on weight_hh_l0" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="295" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="inter" value="Inter-layer Dropout(p=0.3)" style="rounded=1;fillColor=#ECEFF1;strokeColor=#37474F;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="370" width="220" height="40" as="geometry"/></mxCell>
