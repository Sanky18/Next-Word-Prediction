<mxCell id="vd_out" value="Variational Dropout(p=0.4)" style="rounded=1;fillColor=#ECEFF1;strokeColor=#37474F;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="500" width="220" height="40" as="geometry"/></mxCell>
<mxCell id="last" value="h_T = H[:, -1, :]  (B, 256)" style="rounded=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="220" height="40" as="geometry"/></mxCell>
